# Sureplug Environment Configuration

# Express Port
PORT=3000

# Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin authentication credentials
SUPER_ADMIN_EMAILS=ugobright31@gmail.com
JWT_SECRET=your_jwt_secret_here

# Cloudinary credentials for frontend image upload
VITE_CLOUDINARY_CLOUD_NAME=sureplug
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here

# Payment Gateway Configuration
PAYMENT_PROVIDER=kora
DEFAULT_CURRENCY=NGN
KORA_MERCHANT_ID=your_kora_merchant_id_here
KORA_SECRET_KEY=sk_test_your_kora_secret_key_here
KORA_PUBLIC_KEY=pk_test_your_kora_public_key_here
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=your_resend_api_key_here
