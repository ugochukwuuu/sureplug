    "pinia": "^3.0.4",
    "resend": "^6.17.2",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^10.0.3",
    "vite": "^8.1.1"
  }
}
